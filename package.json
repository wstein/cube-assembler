{
  "name": "cube-assembler",
  "version": "0.1.0",
  "description": "Full-stack Rubik's Cube assembler: ReScript + Hono + Bun. Supports 2x2–7x7, WCA notation, webcam capture, scramble generation, SSE-streamed parity pipeline.",
  "type": "module",
  "scripts": {
    "build:res": "rescript build",
    "clean:res": "rescript clean",
    "watch:res": "rescript build -w",
    "dev:server": "bun run --watch server/Server.ts",
    "dev:client": "vite",
    "dev":        "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build":      "npm run build:res && vite build",
    "start":      "bun run server/Server.ts",
    "test":       "vitest run",
    "test:watch": "vitest",
    "test:ui":    "vitest --ui",
    "lint":       "rescript build 2>&1"
  },
  "dependencies": {
    "cubing": "file:./vendor/cubing.js",
    "hono": "^4.5.0",
    "preact": "^10.20.0",
    "preact-router": "^4.1.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.1",
    "@vitest/ui": "^2.1.0",
    "concurrently": "^8.2.2",
    "rescript": "^12.3.1",
    "terser": "^5.30.3",
    "vite": "^5.0.10",
    "vitest": "^2.1.0"
  },
  "trustedDependencies": ["cubing"],
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": ["rubiks-cube", "rescript", "cubing", "hono", "bun", "wca"],
  "license": "MIT"
}
