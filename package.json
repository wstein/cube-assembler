{
  "name": "cube-assembler",
  "version": "0.1.0",
  "description": "Rubik's Cube scanner: reads a physical 2x2-7x7 cube from six camera photos and checks the result (Preact + Vite, runs entirely in the browser).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fixture:server": "node scripts/fixtureUploadServer.mjs",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "preact": "^10.20.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.1",
    "@vitest/ui": "^5.0.1",
    "jpeg-js": "^0.4.4",
    "terser": "^5.30.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "rubiks-cube",
    "wca"
  ],
  "license": "MIT"
}
