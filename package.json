{
  "name": "cube-assembler",
  "version": "0.1.0",
  "description": "Puzzle cube scanner: reads a physical 2x2-7x7 cube from six camera photos and checks the result (Preact + Vite, runs entirely in the browser).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fixture:server": "node scripts/fixtureUploadServer.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint:typescript": "eslint src test e2e scripts vite.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs",
    "lint:rescript": "rescript build --warn-error +a",
    "lint:biome": "biome lint .",
    "lint": "npm run lint:typescript && npm run lint:biome && npm run lint:rescript",
    "format:check": "biome format . && rescript format --check",
    "format": "biome format --write . && rescript format"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "fflate": "^0.8.3",
    "preact": "^10.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.8.1",
    "@types/node": "26.6.3",
    "@vitest/ui": "^5.0.1",
    "ajv": "^8.20.0",
    "eslint": "10.11.0",
    "globals": "17.4.0",
    "jpeg-js": "^0.4.4",
    "rescript": "12.3.1",
    "terser": "^5.30.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "rubiks-cube",
    "wca"
  ],
  "license": "MIT"
}
