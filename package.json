{
  "name": "cube-assembler",
  "version": "0.1.0",
  "description": "Puzzle cube scanner: reads a physical 2x2-7x7 cube from six camera photos and checks the result (Preact + Vite, runs entirely in the browser).",
  "type": "module",
  "scripts": {
    "dev": "npm run rescript:build && node scripts/dev.mjs",
    "rescript:build": "rescript build --warn-error +a",
    "fixture:server": "node scripts/fixtureUploadServer.mjs",
    "build": "npm run rescript:build && vite build",
    "typecheck": "npm run verify:capture-core && npm run verify:viewer-vendor && npm run rescript:build && tsc --noEmit",
    "test": "npm run rescript:build && vitest run",
    "test:e2e": "playwright test",
    "test:watch": "npm run rescript:build && vitest",
    "test:ui": "npm run rescript:build && vitest --ui",
    "lint:typescript": "eslint src test e2e scripts vite.config.ts vitest.config.ts playwright.config.ts eslint.config.mjs",
    "lint:rescript": "npm run rescript:build",
    "lint:biome": "biome lint .",
    "lint": "npm run lint:typescript && npm run lint:biome && npm run lint:rescript",
    "format:check": "biome format . && rescript format --check",
    "format": "biome format --write . && rescript format",
    "verify:capture-core": "node scripts/verifyCaptureCore.mjs",
    "verify:viewer-vendor": "node scripts/verifyViewerVendor.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@puzlwerk/capture-recovery": "file:vendor/puzlwerk-capture-recovery-0.3.0-f1fa30ac.tgz",
    "@puzlwerk/viewer": "file:vendor/puzlwerk-viewer-0.1.0-0ecbe3e8.tgz",
    "fflate": "^0.8.3",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "26.6.6",
    "@vitest/ui": "^5.1.0",
    "ajv": "^8.20.0",
    "eslint": "10.14.0",
    "fast-check": "^4.10.2",
    "globals": "17.14.0",
    "jpeg-js": "^0.4.4",
    "rescript": "12.3.1",
    "terser": "^5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "rubiks-cube",
    "wca"
  ],
  "license": "AGPL-3.0-or-later"
}
